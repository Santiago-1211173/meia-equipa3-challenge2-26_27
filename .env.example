# ==============================================================================
# Configurações do Ambiente do Projeto (Copiar para .env)
# ==============================================================================

# Credenciais da API Kaggle (se aplicável para download automático)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Diretórios locais (opcionais, default: caminhos relativos ao projeto)
DATA_DIR=./data
MODELS_DIR=./models
REPORTS_DIR=./reports

# Nível de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

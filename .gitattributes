# Set default behavior to automatically handle line endings
* text=auto eol=lf

# Windows specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Markdown, YAML, and configuration
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Python source code
*.py text eol=lf

# Jupyter Notebooks
*.ipynb text eol=lf

# LaTeX source files
*.tex text eol=lf
*.bib text eol=lf
*.cls text eol=lf
*.sty text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary

